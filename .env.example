# ── Client-side (safe to expose in the browser) ─────────────────────────────
# From Supabase Dashboard → Project Settings → API
VITE_SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR-ANON-PUBLIC-KEY"

# Google OAuth Client ID (Web application type) — used for BOTH "Sign in with
# Google" and per-user Google Drive uploads of health-report screenshots.
# From Google Cloud Console → APIs & Services → Credentials.
VITE_GOOGLE_CLIENT_ID="YOUR-CLIENT-ID.apps.googleusercontent.com"

# ── Server-side only (Vercel serverless functions under /api) ──────────────
# NEVER expose this to the browser / never prefix with VITE_.
# From Supabase Dashboard → Project Settings → API → service_role secret.
SUPABASE_URL="https://YOUR-PROJECT-REF.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="YOUR-SERVICE-ROLE-SECRET-KEY"
